{
  "description": "AI-Powered Dark Web OSINT Tool",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "robin.png",
  "name": "apurvsg/robin:latest",
  "run_config": {
    "hostname": "kasm"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Productivity"
  ],
  "friendly_name": "Robin",
  "architecture": [
    "amd64",
    "arm64"
  ],
  "compatibility": [
    "1.18.x",
    "1.17.x",
    "1.16.x",
    "1.15.x",
    "1.14.x"
  ],
  "uncompressed_size_mb": 2170
}